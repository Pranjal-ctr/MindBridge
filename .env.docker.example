# Kio — docker compose environment
# Copy to `.env` (compose reads that automatically) and fill in.
#   cp .env.docker.example .env
#
# `.env` is gitignored. Do not commit real values.

# ── Postgres ─────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_DB=mindbridge
# Required, no default. Generate: openssl rand -base64 24
POSTGRES_PASSWORD=

# ── Backend ──────────────────────────────────────────────────────────
# Required. Generate: openssl rand -hex 32
# The app refuses to start in production if this is left at the dev default.
JWT_SECRET_KEY=

ENVIRONMENT=development
DEBUG=false

# JSON array. Must list the exact frontend origin(s), scheme and port included.
CORS_ORIGINS=["http://localhost:8080"]
# JSON array of the API's hostname(s). Required in production; empty is fine
# for local Docker.
ALLOWED_HOSTS=[]
# Error reporting. Empty disables it — that is the switch, both sides.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
VITE_SENTRY_DSN=

# Origin used to build links inside verification / password-reset emails.
# Must be the real public URL in production or those links go nowhere.
FRONTEND_URL=http://localhost:8080

# -------------------------------------------------------------------
# AI providers
# -------------------------------------------------------------------
# Kio supports Google Gemini and OpenAI. Which of them is SUPPORTED is decided
# by the code (backend/app/ai/registry.py); these variables decide which
# supported combination is ACTIVE at startup. A platform admin can change the
# active one at runtime from /admin/ai -- that writes a database row which then
# takes precedence over everything below. Remove that row and these apply again.
#
# Currently: Gemini is the primary provider. OpenAI is fully implemented but
# disabled, because this deployment has no OpenAI credentials yet.

AI_PRIMARY_PROVIDER=gemini
AI_PRIMARY_MODEL=gemini-2.5-flash

# Only consulted when AI_FALLBACK_ENABLED=true. Kept configured-but-off so that
# enabling it later is a one-line change rather than a redesign.
AI_FALLBACK_PROVIDER=openai
AI_FALLBACK_MODEL=gpt-5-mini
AI_FALLBACK_ENABLED=false

# API keys are SERVER-SIDE SECRETS.
#   - never commit a real value to this file or any other
#   - never sent to the frontend; the admin UI only ever learns whether a key
#     is present, as a boolean
#   - never written to the database, the audit log, or the usage telemetry
#
# Only the credential for a provider that is actually in use is required:
#   primary = gemini  -> GEMINI_API_KEY required, OPENAI_API_KEY NOT required
#   primary = openai  -> OPENAI_API_KEY required
#   fallback enabled  -> that provider's key required as well
# A missing OPENAI_API_KEY therefore does not prevent startup today.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Deprecated alias for AI_PRIMARY_MODEL, kept so older .env files keep working.
GEMINI_MODEL=gemini-2.5-flash

# --- Guardrails ----------------------------------------------------
# Hard ceiling on any single provider call. Before this existed, a hung
# provider hung the student's chat request with it, indefinitely.
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS_CEILING=4096
AI_MAX_INPUT_CHARS=60000
AI_USER_REQUESTS_PER_MINUTE=20
AI_FEATURE_REQUESTS_PER_MINUTE=120
AI_GLOBAL_REQUESTS_PER_MINUTE=300
AI_MAX_CONCURRENT_PER_USER=3
# Optional token ceilings; 0 disables. Counted only from tokens providers
# actually report -- usage is never estimated.
AI_DAILY_TOKEN_CEILING=0
AI_MONTHLY_TOKEN_CEILING=0
AI_CIRCUIT_FAILURE_THRESHOLD=5
AI_CIRCUIT_COOLDOWN_SECONDS=60

# Google sign-in. Leave blank to disable (button hides, endpoint returns 503).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# noop = log the link to stdout instead of sending. resend = real delivery.
EMAIL_PROVIDER=noop
RESEND_API_KEY=
EMAIL_FROM=Kio <onboarding@resend.dev>
EMAIL_REPLY_TO=

# Leave at 1 until the rate limiter and background pipeline move to a shared
# store — see the comment in backend/docker-entrypoint.sh.
WEB_CONCURRENCY=1

# ── Frontend (BUILD-time — rebuild the web image after changing) ──────
VITE_API_BASE_URL=http://localhost:8000
VITE_GOOGLE_CLIENT_ID=

# ── Host port mapping ────────────────────────────────────────────────
API_PORT=8000
WEB_PORT=8080
