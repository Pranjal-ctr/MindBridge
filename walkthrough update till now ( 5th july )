```python
# Only extract if:
#   1. memory_type in [goal, academic, emotion, relationship]  (ALWAYS store)
#   2. OR importance >= 0.75

# Extraction prompt asks Gemini to return JSON:
[
  {
    "type": "goal",
    "content": "Wants to become a software engineer",
    "importance": 0.92,
    "confidence": 0.95
  }
]
