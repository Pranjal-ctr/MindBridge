# Kio Backend — Environment Variables
# Copy to .env and fill in your values

# Application
APP_NAME=Kio API
DEBUG=true
ENVIRONMENT=development

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mindbridge
DB_ECHO=false
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# JWT Authentication
JWT_SECRET_KEY=change-this-to-a-random-64-char-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma-separated if multiple)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# AI / Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Google OAuth (Sign in with Google) -- leave blank to disable the feature
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public URL of the frontend — used to build links inside emails.
# Must be the real deployed origin in production (e.g. https://app.yourdomain.com).
FRONTEND_URL=http://localhost:5173

# Email delivery
#   noop   = log the link instead of sending (default; use for local dev)
#   resend = send via Resend. Requires RESEND_API_KEY + a domain verified in Resend.
EMAIL_PROVIDER=noop
RESEND_API_KEY=
# Sender must be on a domain verified with the provider. Resend's shared
# onboarding@resend.dev works before verification but only delivers to your own address.
EMAIL_FROM=Kio <onboarding@resend.dev>
EMAIL_REPLY_TO=

# One-time link lifetimes
EMAIL_VERIFY_TOKEN_HOURS=24
PASSWORD_RESET_TOKEN_HOURS=1
