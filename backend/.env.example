# Kio Backend — Environment Variables
# Copy to .env and fill in your values

# Application
APP_NAME=Kio API
DEBUG=true
ENVIRONMENT=development

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mindbridge
DB_ECHO=false
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# JWT Authentication
JWT_SECRET_KEY=change-this-to-a-random-64-char-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma-separated if multiple)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# -------------------------------------------------------------------
# AI providers
# -------------------------------------------------------------------
# Kio supports Google Gemini and OpenAI. Which of them is SUPPORTED is decided
# by the code (backend/app/ai/registry.py); these variables decide which
# supported combination is ACTIVE at startup. A platform admin can change the
# active one at runtime from /admin/ai -- that writes a database row which then
# takes precedence over everything below. Remove that row and these apply again.
#
# Currently: Gemini is the primary provider. OpenAI is fully implemented but
# disabled, because this deployment has no OpenAI credentials yet.

AI_PRIMARY_PROVIDER=gemini
AI_PRIMARY_MODEL=gemini-2.5-flash

# Only consulted when AI_FALLBACK_ENABLED=true. Kept configured-but-off so that
# enabling it later is a one-line change rather than a redesign.
AI_FALLBACK_PROVIDER=openai
AI_FALLBACK_MODEL=gpt-5-mini
AI_FALLBACK_ENABLED=false

# API keys are SERVER-SIDE SECRETS.
#   - never commit a real value to this file or any other
#   - never sent to the frontend; the admin UI only ever learns whether a key
#     is present, as a boolean
#   - never written to the database, the audit log, or the usage telemetry
#
# Only the credential for a provider that is actually in use is required:
#   primary = gemini  -> GEMINI_API_KEY required, OPENAI_API_KEY NOT required
#   primary = openai  -> OPENAI_API_KEY required
#   fallback enabled  -> that provider's key required as well
# A missing OPENAI_API_KEY therefore does not prevent startup today.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Deprecated alias for AI_PRIMARY_MODEL, kept so older .env files keep working.
GEMINI_MODEL=gemini-2.5-flash

# --- Guardrails ----------------------------------------------------
# Hard ceiling on any single provider call. Before this existed, a hung
# provider hung the student's chat request with it, indefinitely.
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS_CEILING=4096
AI_MAX_INPUT_CHARS=60000
AI_USER_REQUESTS_PER_MINUTE=20
AI_FEATURE_REQUESTS_PER_MINUTE=120
AI_GLOBAL_REQUESTS_PER_MINUTE=300
AI_MAX_CONCURRENT_PER_USER=3
# Optional token ceilings; 0 disables. Counted only from tokens providers
# actually report -- usage is never estimated.
AI_DAILY_TOKEN_CEILING=0
AI_MONTHLY_TOKEN_CEILING=0
AI_CIRCUIT_FAILURE_THRESHOLD=5
AI_CIRCUIT_COOLDOWN_SECONDS=60

# Google OAuth (Sign in with Google) -- leave blank to disable the feature
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public URL of the frontend — used to build links inside emails.
# Must be the real deployed origin in production (e.g. https://app.yourdomain.com).
FRONTEND_URL=http://localhost:5173

# Email delivery
#   noop   = log the link instead of sending (default; use for local dev)
#   resend = send via Resend. Requires RESEND_API_KEY + a domain verified in Resend.
EMAIL_PROVIDER=noop
RESEND_API_KEY=
# Sender must be on a domain verified with the provider. Resend's shared
# onboarding@resend.dev works before verification but only delivers to your own address.
EMAIL_FROM=Kio <onboarding@resend.dev>
EMAIL_REPLY_TO=

# One-time link lifetimes
EMAIL_VERIFY_TOKEN_HOURS=24
PASSWORD_RESET_TOKEN_HOURS=1

# --- Observability ---------------------------------------------------
# Empty DSN = reporting disabled. That absence is the switch, so development
# and CI cannot report into a production project by forgetting a flag.
# app/observability.py strips request bodies, tokens and user identifiers.
# Hosts the API answers for, as a JSON array. REQUIRED in production —
# startup refuses an empty list or a wildcard.
ALLOWED_HOSTS=[]

# --- One-time production bootstrap (see docs/deployment.md) -----------
# Used only by `python -m database.bootstrap`, which creates the FIRST school
# and platform admin and refuses once any admin exists. Supply these for that
# one command; they do not belong in the running service's environment.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_SCHOOL_NAME=
BOOTSTRAP_SCHOOL_CODE=

SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Production hardening --------------------------------------------
# Hostnames this API answers for. Empty = any, which is fine locally and wrong
# in production: without it a spoofed Host header can rewrite the absolute
# URLs in password-reset emails to point at somebody else's domain.
# Example: ALLOWED_HOSTS=["api.kio.example"]
ALLOWED_HOSTS=[]

# Redirect http -> https. Leave false behind a TLS-terminating proxy, which
# forwards plain http internally and would otherwise redirect forever.
FORCE_HTTPS=false
