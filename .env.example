# Kio Frontend — Environment Variables
# Copy to .env.local (Vite) and fill in your values.
#
# NOTE: VITE_* values are inlined at BUILD time, not read at runtime — after
# changing one you must rebuild and redeploy, not just restart.
# Full setup walkthrough: docs/domain-google-auth-and-email.md

# Backend API base URL
VITE_API_BASE_URL=http://localhost:8000

# Google OAuth client ID (public). Leave blank to hide the "Continue with Google" button.
# Must match GOOGLE_CLIENT_ID configured on the backend.
VITE_GOOGLE_CLIENT_ID=

# --- Error reporting (build-time, like every VITE_* value) -----------
# Empty disables it. Session replay and tracing are off by design: replay
# would record the chat screen, the most sensitive surface in the product.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
